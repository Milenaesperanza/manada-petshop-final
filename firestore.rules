rules_version = '2';

// Reglas sugeridas. Publicalas desde Firebase Console → Firestore → Reglas
// (o con `firebase deploy --only firestore:rules`).
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lectura pública. Escritura sólo desde la consola / Admin SDK.
    match /productos/{productoId} {
      allow read: if true;
      // El stock sólo lo modifica la Cloud Function de checkout (Admin SDK).
      allow update: if false;
      allow create, delete: if false;
    }

    // Categorías del menú y del catálogo: lectura pública.
    match /categorias/{categoriaId} {
      allow read: if true;
      allow write: if false;
    }

    // Animales que se muestran como categorías principales en el header.
    match /animal/{animalId} {
      allow read: if true;
      allow write: if false;
    }

    // Pedidos: cada usuario crea y lee únicamente los suyos.
    match /orders/{pedidoId} {
      // La Cloud Function valida precios, total, cantidades y stock.
      allow create: if false;
      allow read: if request.auth != null
                  && resource.data.usuarioId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
